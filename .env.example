# ==============================================================================
# THEWHY CONSULTING (why.ng) - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env on your server and fill in real values:
#   cp .env.example .env
# Never commit .env (it is gitignored).
#
# Generate strong random values with, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Public base URL, used for the sitemap, canonical/OG tags and email links.
SITE_URL=https://why.ng
# Comma-separated list of origins allowed to call the API cross-origin.
# In development, http://localhost:PORT and http://127.0.0.1:PORT are added automatically.
CORS_ORIGINS=https://why.ng,https://www.why.ng
# Number of reverse proxies in front of the app (for correct client IPs in rate limiting).
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# ADMIN CONSOLE SECURITY (required in production)
# ------------------------------------------------------------------------------
# Passcode for /admin. Production refuses to start if this is unset, shorter than
# 12 characters, or a published default. In development, a temporary random
# passcode is generated and printed to the console if unset.
ADMIN_PASSCODE=change-me-to-a-long-random-string
# Secret used to sign admin session cookies (HMAC-SHA256). At least 32 characters.
# Required in production; in development a random per-process secret is used if unset.
# Changing it (or ADMIN_PASSCODE) signs out every admin session.
ADMIN_SESSION_SECRET=change-me-to-another-long-random-string-of-32-plus-chars
# Failed login attempts allowed per IP per 15 minutes (default 10).
# ADMIN_LOGIN_MAX_ATTEMPTS=10

# Optional rate limits (requests per IP per 15 minutes)
# FORM_RATE_LIMIT=30     # public form POSTs (bookings, contact, inquiries, newsletter)
# API_RATE_LIMIT=600     # all /api requests

# ------------------------------------------------------------------------------
# DATABASE (MySQL recommended in production)
# ------------------------------------------------------------------------------
# If MySQL is unreachable the app falls back to a local JSON file. On hosts with
# ephemeral disks (Render, Railway, Heroku) that data is LOST on redeploy, and a
# warning is logged at startup.
#
# DB_MODE=json forces the JSON store (useful for local dev and tests).
# DB_MODE=json
# Location of the JSON fallback store (gitignored). Default: server/data/runtime-db.json
# DB_JSON_PATH=server/data/runtime-db.json

# OPTION A: Single connection URL (Railway, Render, PlanetScale, etc.)
# DATABASE_URL=mysql://db_user:db_password@db_host:3306/whyng_db

# OPTION B: Discrete connection parameters (cPanel, VPS, remote MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=whyng_user
DB_PASSWORD=your_strong_mysql_password
DB_NAME=whyng_db

# Optional connection pool tuning
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=5000

# ------------------------------------------------------------------------------
# EMAIL NOTIFICATIONS (optional)
# ------------------------------------------------------------------------------
# On each new booking, contact message, inquiry or programme application the
# server emails an internal notification to NOTIFY_TO and a short confirmation to
# the client. Mail is sent in the background; failures are logged and never fail
# the request. If no transport is configured, email is skipped
# ("[MAIL] Email not configured, skipping" is logged once).
#
# Option 1 (recommended): Brevo transactional API. Use an API key (starts with
# xkeysib-), from Brevo > Settings > SMTP & API > API Keys. SMTP keys
# (xsmtpsib-) do NOT work here. The MAIL_FROM address must be a verified
# sender in Brevo.
BREVO_API_KEY=
#
# Option 2: any SMTP server (used only when BREVO_API_KEY is empty).
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="THEWHY Consulting <info@thewhy.ng>"
NOTIFY_TO=info@thewhy.ng

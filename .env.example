# ==============================================================================
# THEWHY CONSULTING (why.ng) - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env on your deployment server:
# cp .env.example .env
#
# Fill in your production MySQL credentials or provide DATABASE_URL.
# If MySQL is not reachable, the system operates seamlessly in resilient
# JSON fallback mode (server/data/database.json).
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=production

# Admin Console Security Passcode (Keep private!)
ADMIN_PASSCODE=whyng2026

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (CHOOSE ONE OPTION)
# ------------------------------------------------------------------------------

# OPTION A: Single Connection URL (Recommended for Railway, Render, Heroku)
# DATABASE_URL=mysql://db_user:db_password@db_host:3306/whyng_db?ssl={"rejectUnauthorized":true}

# OPTION B: Discrete Connection Parameters (Standard cPanel, VPS, or Remote MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=whyng_user
DB_PASSWORD=your_strong_mysql_password
DB_NAME=whyng_db

# Optional Connection Pool Tuning
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=5000
